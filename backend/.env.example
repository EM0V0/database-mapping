# Required for GPT-powered mapping workflows
OPENAI_API_KEY=

# Leave blank unless you proxy through OpenAI-compatible providers.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier — must support JSON-schema mode for field recommendations when using OpenAI.
OPENAI_MODEL=gpt-4o

# --- Hardening (production SHOULD override these) ---
# Total multipart payload limit enforced by Flask (megabytes).
# MAX_UPLOAD_MB=25

# Comma-separated list of browser origins permitted to call the API with cookies/credentials disabled.
# For public sandboxes ONLY you may temporarily set "*" (never ship that to regulated environments).
# CORS_ALLOWED_ORIGINS=http://localhost:8080

# Clamp serialized prompts sent upstream (characters, includes JSON context blocks).
# MAX_LLM_PROMPT_CHARS=350000

# LLM behaviour — repair rounds plus temperatures for structured JSON vs SQL paths.
# LLM_REPAIR_ATTEMPTS=2
# LLM_TEMP_STRUCTURE=0.12
# LLM_TEMP_SQL=0.22
